<Window x:Class="PlugINPRO.DoorPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор двери" 
        Width="1200" 
        Height="850"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Topmost="True"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Стиль для кнопки-заголовка группы -->
        <Style x:Key="GroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0"/>
                                <Path Grid.Column="1"
                                      x:Name="ArrowPath"
                                      Data="M0,0 L8,8 L16,0"
                                      Fill="White"
                                      Width="16"
                                      Height="16"
                                      Stretch="Fill"
                                      Margin="0,0,10,0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotation" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для контейнера группы -->
        <Style x:Key="GroupContentStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0,0,5,5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с параметрами -->
        <ScrollViewer Grid.Column="0" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <StackPanel Margin="10">

                <!-- Заголовок -->
                <TextBlock Text="Редактор параметров двери" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Margin="0,0,0,15"
                           Foreground="#2C3E50"/>

                <!-- Текущий тип двери -->
                <GroupBox Header="Текущий типоразмер" Margin="0,0,0,10" Padding="5" BorderBrush="#3498DB" BorderThickness="2">
                    <StackPanel>
                        <TextBlock x:Name="CurrentTypeText" 
                                   Text="Не выбран" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="5"
                                   TextWrapping="Wrap"/>
                        <Border Background="#ECF0F1" CornerRadius="3" Padding="5" Margin="5">
                            <TextBlock x:Name="CurrentTypeFamilyText" 
                                       Text="Семейство: " 
                                       FontSize="12"
                                       Foreground="#7F8C8D"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Типоразмеры -->
                <GroupBox Header="Выбор типоразмера" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <ComboBox x:Name="TypeComboBox" 
                                  Margin="0,5" 
                                  Height="30"
                                  SelectionChanged="TypeComboBox_SelectionChanged"/>

                        <!-- Inline интерфейс создания типа -->
                        <Border Background="#F8F9F9" CornerRadius="3" Padding="5" Margin="0,5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewTypeNameTextBox" 
                                         Grid.Column="0"
                                         Height="30"
                                         Margin="0,0,5,0"
                                         Padding="5"
                                         Text=""
                                         ToolTip="Введите имя нового типоразмера"/>
                                <Button x:Name="CreateTypeButton" 
                                        Grid.Column="1"
                                        Content="Создать" 
                                        Width="80"
                                        Height="30"
                                        Click="CreateTypeButton_Click"
                                        Background="#27AE60"
                                        Foreground="White"
                                        BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Размеры (грубые параметры + системные размеры) -->
                <GroupBox Header="Размеры двери" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <!-- Ширина -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Примерная ширина -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Ширина примерная:" FontWeight="SemiBold" 
                                       ToolTip="Параметр FAMILY_ROUGH_WIDTH_PARAM"/>
                                <TextBox x:Name="WidthTextBox" 
                                         Height="30" 
                                         Padding="5"
                                         TextChanged="Parameter_TextChanged"/>
                            </StackPanel>

                            <!-- Разделитель -->
                            <Border Grid.Column="1" 
                                    Width="1" 
                                    Background="#BDC3C7" 
                                    Margin="5,25,5,0"
                                    HorizontalAlignment="Center"/>

                            <!-- Системная ширина -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Ширина (системная):" FontWeight="SemiBold"
                                       ToolTip="BuiltInParameter.DOOR_WIDTH"/>
                                <TextBox x:Name="DoorWidthTextBox" 
                                         Height="30" 
                                         Padding="5"
                                         IsReadOnly="True"
                                         Background="#F0F0F0"
                                         Foreground="#2C3E50"
                                         FontWeight="SemiBold"
                                         BorderBrush="#BDC3C7"/>
                            </StackPanel>
                        </Grid>

                        <!-- Высота -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Примерная высота -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Высота примерная:" FontWeight="SemiBold"
                                       ToolTip="Параметр FAMILY_ROUGH_HEIGHT_PARAM"/>
                                <TextBox x:Name="HeightTextBox" 
                                         Height="30" 
                                         Padding="5"
                                         TextChanged="Parameter_TextChanged"/>
                            </StackPanel>

                            <!-- Разделитель -->
                            <Border Grid.Column="1" 
                                    Width="1" 
                                    Background="#BDC3C7" 
                                    Margin="5,25,5,0"
                                    HorizontalAlignment="Center"/>

                            <!-- Системная высота -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Высота (системная):" FontWeight="SemiBold"
                                       ToolTip="BuiltInParameter.DOOR_HEIGHT"/>
                                <TextBox x:Name="DoorHeightTextBox" 
                                         Height="30" 
                                         Padding="5"
                                         IsReadOnly="True"
                                         Background="#F0F0F0"
                                         Foreground="#2C3E50"
                                         FontWeight="SemiBold"
                                         BorderBrush="#BDC3C7"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Секция: Материалы и отделка (аккордеон) -->
                <Button x:Name="MaterialsHeaderButton"
                        Style="{StaticResource GroupHeaderButtonStyle}"
                        Background="#27AE60"
                        Click="ToggleGroup_Click"
                        Tag="Materials">
                    <TextBlock Text="Материалы и отделка"/>
                </Button>

                <Border x:Name="MaterialsContent"
                        Style="{StaticResource GroupContentStyle}"
                        Visibility="Collapsed">
                    <StackPanel x:Name="MaterialsStackPanel" Margin="0">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </Border>

                <!-- Секция: Construction (аккордеон) -->
                <Button x:Name="ConstructionHeaderButton"
                        Style="{StaticResource GroupHeaderButtonStyle}"
                        Background="#E67E22"
                        Click="ToggleGroup_Click"
                        Tag="Construction">
                    <TextBlock Text="Construction"/>
                </Button>

                <Border x:Name="ConstructionContent"
                        Style="{StaticResource GroupContentStyle}"
                        Visibility="Collapsed">
                    <StackPanel x:Name="ConstructionStackPanel" Margin="0">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров Construction..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </Border>

                <!-- Секция: Visibility (аккордеон) -->
                <Button x:Name="VisibilityHeaderButton"
                        Style="{StaticResource GroupHeaderButtonStyle}"
                        Background="#3498DB"
                        Click="ToggleGroup_Click"
                        Tag="Visibility">
                    <TextBlock Text="Visibility"/>
                </Button>

                <Border x:Name="VisibilityContent"
                        Style="{StaticResource GroupContentStyle}"
                        Visibility="Collapsed">
                    <StackPanel x:Name="VisibilityStackPanel" Margin="0">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров Visibility..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </Border>

                <!-- Секция: Other (аккордеон) -->
                <Button x:Name="OtherHeaderButton"
                        Style="{StaticResource GroupHeaderButtonStyle}"
                        Background="#9B59B6"
                        Click="ToggleGroup_Click"
                        Tag="Other">
                    <TextBlock Text="Other"/>
                </Button>

                <Border x:Name="OtherContent"
                        Style="{StaticResource GroupContentStyle}"
                        Visibility="Collapsed">
                    <StackPanel x:Name="OtherStackPanel" Margin="0">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров Other..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </Border>

                <!-- Статус -->
                <Border Background="#ECF0F1" 
                        CornerRadius="5" 
                        Padding="5"
                        Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" 
                               Text="Готово" 
                               Foreground="#7F8C8D"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель с изображением и схемой -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок над изображением -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="#3498DB"
                    CornerRadius="5,5,0,0"
                    Margin="0,0,5,0">
                <TextBlock Text="3D Вид" 
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="5"/>
            </Border>

            <!-- Заголовок над схемой -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="#27AE60"
                    CornerRadius="5,5,0,0"
                    Margin="5,0,0,0">
                <TextBlock Text="Схема с размерами" 
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="5"/>
            </Border>

            <!-- Border для 3D изображения (слева) -->
            <Border Grid.Row="1" Grid.Column="0"
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    CornerRadius="0,0,0,5"
                    Background="White"
                    Margin="0,0,5,5">
                <Image x:Name="DoorImage" 
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="5"/>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Row="1" Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True"
                          Width="5"
                          Background="LightGray"
                          Margin="0,0,0,5"/>

            <!-- Border для схемы (справа) -->
            <Border Grid.Row="1" Grid.Column="2"
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    CornerRadius="0,0,5,0"
                    Background="White"
                    Margin="5,0,0,5">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="DiagramCanvas" 
                            Width="300" 
                            Height="400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White">
                        <!-- Здесь будут рисоваться элементы схемы -->
                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- Кнопка "Обновить изображение" в правом нижнем углу -->
            <Button Grid.Row="2" Grid.Column="2"
                    x:Name="UpdateAndRefreshButton" 
                    Content="Обновить изображение" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="200"
                    Height="40"
                    Margin="5,10,0,5"
                    IsEnabled="False"
                    Click="UpdateAndRefreshButton_Click"
                    FontWeight="Bold"
                    Background="#3498DB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
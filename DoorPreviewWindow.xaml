<Window x:Class="PlugINPRO.DoorPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор двери" 
        Width="1200" 
        Height="850"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Topmost="True"
        Closed="Window_Closed">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с параметрами -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">

                <!-- Заголовок -->
                <TextBlock Text="Редактор параметров двери" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Margin="0,0,0,15"
                           Foreground="#2C3E50"/>

                <!-- Текущий тип двери -->
                <GroupBox Header="Текущий типоразмер" Margin="0,0,0,10" Padding="5" BorderBrush="#3498DB" BorderThickness="2">
                    <StackPanel>
                        <TextBlock x:Name="CurrentTypeText" 
                                   Text="Не выбран" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Margin="5"
                                   TextWrapping="Wrap"/>
                        <Border Background="#ECF0F1" CornerRadius="3" Padding="5" Margin="5">
                            <TextBlock x:Name="CurrentTypeFamilyText" 
                                       Text="Семейство: " 
                                       FontSize="12"
                                       Foreground="#7F8C8D"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Типоразмеры -->
                <GroupBox Header="Выбор типоразмера" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <ComboBox x:Name="TypeComboBox" 
                                  Margin="0,5" 
                                  Height="30"
                                  SelectionChanged="TypeComboBox_SelectionChanged"/>

                        <!-- Inline интерфейс создания типа -->
                        <Border Background="#F8F9F9" CornerRadius="3" Padding="5" Margin="0,5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewTypeNameTextBox" 
                                         Grid.Column="0"
                                         Height="30"
                                         Margin="0,0,5,0"
                                         Padding="5"
                                         Text=""
                                         ToolTip="Введите имя нового типоразмера"/>
                                <Button x:Name="CreateTypeButton" 
                                        Grid.Column="1"
                                        Content="Создать" 
                                        Width="80"
                                        Height="30"
                                        Click="CreateTypeButton_Click"
                                        Background="#27AE60"
                                        Foreground="White"
                                        BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Размеры (грубые параметры) -->
                <GroupBox Header="Примерные размеры (мм)" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <Label Content="Ширина:" Margin="0,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="WidthTextBox" 
                                 Margin="0,0,0,10" 
                                 Height="30"
                                 Padding="5"
                                 TextChanged="Parameter_TextChanged"/>

                        <Label Content="Высота:" Margin="0,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="HeightTextBox" 
                                 Margin="0,0,0,5" 
                                 Height="30"
                                 Padding="5"
                                 TextChanged="Parameter_TextChanged"/>
                    </StackPanel>
                </GroupBox>

                <!-- Секция: Материалы и отделка -->
                <GroupBox Header="Материалы и отделка" Margin="0,0,0,10" Padding="5" BorderBrush="#27AE60" BorderThickness="1">
                    <StackPanel x:Name="MaterialsStackPanel" Margin="0,5,0,5">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </GroupBox>

                <!-- Секция: Construction (НОВАЯ) -->
                <GroupBox Header="Construction" Margin="0,0,0,10" Padding="5" BorderBrush="#E67E22" BorderThickness="1">
                    <StackPanel x:Name="ConstructionStackPanel" Margin="0,5,0,5">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров Construction..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </GroupBox>

                <!-- Секция: Other (НОВАЯ) -->
                <GroupBox Header="Other" Margin="0,0,0,10" Padding="5" BorderBrush="#9B59B6" BorderThickness="1">
                    <StackPanel x:Name="OtherStackPanel" Margin="0,5,0,5">
                        <!-- Сюда будут динамически добавляться параметры -->
                        <TextBlock Text="Загрузка параметров Other..." 
                                   Foreground="Gray" 
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </GroupBox>

                <!-- Кнопки управления -->
                <Button x:Name="UpdateAndRefreshButton" 
                        Content="Обновить изображение" 
                        Margin="0,5" 
                        Height="40"
                        IsEnabled="False"
                        Click="UpdateAndRefreshButton_Click"
                        FontWeight="Bold"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button x:Name="ApplyButton" 
                        Content="Применить изменения" 
                        Margin="0,5" 
                        Height="40"
                        IsEnabled="False"
                        Click="ApplyButton_Click"
                        FontWeight="Bold"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button x:Name="CloseButton" 
                        Content="Закрыть" 
                        Margin="0,5,0,0" 
                        Height="35"
                        Click="CloseButton_Click"
                        Background="#95A5A6"
                        Foreground="White"
                        BorderThickness="0"/>

                <!-- Статус -->
                <Border Background="#ECF0F1" 
                        CornerRadius="5" 
                        Padding="5"
                        Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText" 
                               Text="Готово" 
                               Foreground="#7F8C8D"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель с изображением и схемой -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок над изображением -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="#3498DB"
                    CornerRadius="5,5,0,0"
                    Margin="0,0,5,0">
                <TextBlock Text="3D Вид" 
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="5"/>
            </Border>

            <!-- Заголовок над схемой -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="#27AE60"
                    CornerRadius="5,5,0,0"
                    Margin="5,0,0,0">
                <TextBlock Text="Схема с размерами" 
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="5"/>
            </Border>

            <!-- Border для 3D изображения (слева) -->
            <Border Grid.Row="1" Grid.Column="0"
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    CornerRadius="0,0,5,5"
                    Background="White"
                    Margin="0,0,5,0">
                <Image x:Name="DoorImage" 
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="5"/>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Row="1" Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True"
                          Width="5"
                          Background="LightGray"/>

            <!-- Border для схемы (справа) -->
            <Border Grid.Row="1" Grid.Column="2"
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    CornerRadius="0,0,5,5"
                    Background="White"
                    Margin="5,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="DiagramCanvas" 
                            Width="300" 
                            Height="400"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White">
                        <!-- Здесь будут рисоваться элементы схемы -->
                    </Canvas>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
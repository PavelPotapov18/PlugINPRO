<Window x:Class="PlugINPRO.UI.Windows.BIM.IFCRVTWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Title="Пакетная обработка IFC"
             Height="200"
             Width="500"
             WindowStartupLocation="CenterScreen"
             ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Источник -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Папка-источник"/>
            <DockPanel>
                <TextBox x:Name="SourceBox" Width="380"/>
                <Button Content="Обзор..."
                        Width="80"
                        Margin="5,0,0,0"
                        Click="BrowseSource"/>
            </DockPanel>
        </StackPanel>

        <!-- Назначение -->
        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <TextBlock Text="Папка-назначение"/>
            <DockPanel>
                <TextBox x:Name="TargetBox" Width="380"/>
                <Button Content="Обзор..."
                        Width="80"
                        Margin="5,0,0,0"
                        Click="BrowseTarget"/>
            </DockPanel>
        </StackPanel>

        <Button Grid.Row="2"
                Content="ОК"
                Height="35"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Width="100"
                Click="OnConfirm"/>
    </Grid>
</Window>

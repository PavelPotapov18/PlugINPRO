<Window x:Class="PlugINPRO.UI.Windows.AR.FloorSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlugINPRO.Services.AR"
             xmlns:ar="clr-namespace:PlugINPRO.Services.AR"
        Title="Настройка пола"
             Height="450" Width="600"
             WindowStartupLocation="CenterScreen">
    

            <Window.Resources>
                <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

         <!-- Режим выбора помещений -->
        <GroupBox Header="Режим обработки" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton Content="Выбранные помещения"
                             IsChecked="{Binding IsSelectedRooms}"/>
                <RadioButton Content="По параметрам помещений"
                             IsChecked="{Binding IsFilteredRooms}"/>
                <!-- Панель фильтра -->
                <Border Margin="20,6,0,0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6"
                        Visibility="{Binding IsFilterPanelVisible,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>

                        <DataGrid x:Name="FilterGrid"
                                  ItemsSource="{Binding FilterRules}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  MaxHeight="150"
                                  Margin="0,0,0,6">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Параметр" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox
                                                ItemsSource="{Binding DataContext.RoomParameterNames,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                Tag="{Binding}"
                                                DisplayMemberPath="."
                                                Loaded="FilterParamCombo_Loaded"
                                                SelectionChanged="FilterParamCombo_SelectionChanged"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Условие" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Tag="{Binding}"
                                                      Loaded="FilterConditionCombo_Loaded"
                                                      SelectionChanged="FilterConditionCombo_SelectionChanged">
                                                <ComboBoxItem Content="Равно"
                                                              Tag="{x:Static ar:RoomFilterCondition.Equals}"/>
                                                <ComboBoxItem Content="Не равно"
                                                              Tag="{x:Static ar:RoomFilterCondition.NotEquals}"/>
                                                <ComboBoxItem Content="Содержит"
                                                              Tag="{x:Static ar:RoomFilterCondition.Contains}"/>
                                                <ComboBoxItem Content="Не содержит"
                                                              Tag="{x:Static ar:RoomFilterCondition.NotContains}"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Значение" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Условие"
                                    Width="90" Margin="0,0,6,0"
                                    Click="AddFilterRule_Click"/>
                            <Button Content="- Условие"
                                    Width="90"
                                    Click="DeleteFilterRule_Click"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </GroupBox>
        <TextBlock Grid.Row="1"
                   Text="Выберите тип пола:"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"/>

        <ComboBox Grid.Row="2"
                  ItemsSource="{Binding FloorTypes}"
                  SelectedItem="{Binding SelectedFloorType, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,15"/>

        <!-- Режим дверных проёмов -->
        <TextBlock Grid.Row="3"
                   Text="Контур пола в дверных проёмах:"
                   Margin="0,0,0,4"
                   FontWeight="SemiBold"/>
        <ComboBox Grid.Row="4"
                  SelectedValue="{Binding DoorOffsetMode, Mode=TwoWay}"
                  SelectedValuePath="Tag"
                  Margin="0,0,0,8">
            <ComboBoxItem Content="Не заводить контур в дверные проёмы"
                          Tag="{x:Static ar:DoorOffsetMode.None}"/>
            <ComboBoxItem Content="Заводить контур до середины стены"
                          Tag="{x:Static ar:DoorOffsetMode.ToWallCenter}"/>
            <ComboBoxItem Content="Заводить контур на всю толщину стены"
                          Tag="{x:Static ar:DoorOffsetMode.ToWallFull}"/>
            <ComboBoxItem Content="Заводить контур на указанное значение, мм"
                          Tag="{x:Static ar:DoorOffsetMode.Custom}"/>
        </ComboBox>

        <!-- Поле ввода для Custom -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Visibility="{Binding IsCustomOffset,
                        Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,8">
            <TextBlock Text="Значение смещения, мм:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Width="80"
                     Text="{Binding CustomOffsetMm, Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}" Height="25"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="ОК"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="Ok_Click"/>
            <Button Content="Отмена"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

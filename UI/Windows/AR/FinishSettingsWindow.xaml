<Window x:Class="PlugINPRO.UI.Windows.AR.FinishSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlugINPRO.Services.AR"
             xmlns:ar="clr-namespace:PlugINPRO.Services.AR" 
        Title="Настройка отделки"
             Height="600" Width="900">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Режим выбора помещений -->
        <GroupBox Header="Режим обработки" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton Content="Выбранные помещения"
             GroupName="RoomProcessingMode"
             IsChecked="{Binding IsSelectedRooms, Mode=TwoWay}"/>
                <RadioButton Content="По параметрам помещений"
             GroupName="RoomProcessingMode"
             IsChecked="{Binding IsFilteredRooms, Mode=TwoWay}"/>
            </StackPanel>
        </GroupBox>
        <!-- Панель фильтра -->
        <Border Margin="20,6,0,0"
        Grid.Row="1"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="3"
        Padding="6"
        Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <GroupBox Header="Логика фильтра"
                  Margin="0,10,0,10">

                    <StackPanel Margin="5">
                        <RadioButton
                    Content="Все условия"
                    IsChecked="{Binding FilterMatchMode,
                    Mode=TwoWay,
                    Converter={StaticResource EnumToBooleanConverter},
                    ConverterParameter=All}"/>

                        <RadioButton
                    Content="Хотя бы одно условие"
                    IsChecked="{Binding FilterMatchMode,
                    Mode=TwoWay,
                    Converter={StaticResource EnumToBooleanConverter},
                    ConverterParameter=Any}"/>

                    </StackPanel>

                </GroupBox>

                <DataGrid x:Name="FilterGrid"
                  ItemsSource="{Binding FilterRules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  MaxHeight="150"
                  Margin="0,0,0,6">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Параметр" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                ItemsSource="{Binding DataContext.RoomParameterNames,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                Tag="{Binding}"
                                DisplayMemberPath="."
                                Loaded="FilterParamCombo_Loaded"
                                SelectionChanged="FilterParamCombo_SelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Условие" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Tag="{Binding}"
                                      Loaded="FilterConditionCombo_Loaded"
                                      SelectionChanged="FilterConditionCombo_SelectionChanged">
                                        <ComboBoxItem Content="Равно"
                                              Tag="{x:Static ar:RoomFilterCondition.Equals}"/>
                                        <ComboBoxItem Content="Не равно"
                                              Tag="{x:Static ar:RoomFilterCondition.NotEquals}"/>
                                        <ComboBoxItem Content="Содержит"
                                              Tag="{x:Static ar:RoomFilterCondition.Contains}"/>
                                        <ComboBoxItem Content="Не содержит"
                                              Tag="{x:Static ar:RoomFilterCondition.NotContains}"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Значение" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Условие"
                    Width="90" Margin="0,0,6,0"
                    Click="AddFilterRule_Click"/>
                    <Button Content="- Условие"
                    Width="90"
                    Click="DeleteFilterRule_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Правила -->
        <DataGrid Grid.Row="2"
                  x:Name="RulesGrid"
                  ItemsSource="{Binding Rules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            

            <DataGrid.Columns>

                <!-- Стена-основа -->
                <DataGridTemplateColumn Header="Тип стены основы" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding Tag.WallTypes,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                DisplayMemberPath="Name"
                                Tag="{Binding}"
                                SelectionChanged="SourceWallTypeCombo_SelectionChanged"
                                Loaded="SourceWallTypeCombo_Loaded"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Количество слоёв (информационно) -->
                <DataGridTemplateColumn Header="Слоёв" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Layers.Count}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <!-- Вложенная таблица слоёв -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Margin="30,4,4,4"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel>

                            <DataGrid
                                x:Name="LayersGrid"
                                ItemsSource="{Binding Layers}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                Margin="4"
                                Tag="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">

                                <DataGrid.Columns>

                                    <!-- Тип отделки -->
                                    <DataGridTemplateColumn Header="Тип отделки" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    ItemsSource="{Binding Tag.WallTypes,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    DisplayMemberPath="Name"
                                                    Tag="{Binding}"
                                                    SelectionChanged="FinishWallTypeCombo_SelectionChanged"
                                                    Loaded="FinishWallTypeCombo_Loaded"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Отступ от низа (мм) -->
                                    <DataGridTemplateColumn Header="Отступ от низа (мм)" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding BaseOffsetMm, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Высота (мм) -->
                                    <DataGridTemplateColumn Header="Высота (мм)" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding HeightMm, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- Кнопки управления слоями -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="4,0,4,4">
                                <Button Content="+ Слой"
                                        Width="80"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="AddLayer_Click"/>
                                <Button Content="- Слой"
                                        Width="80"
                                        Tag="{Binding}"
                                        Click="DeleteLayer_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

        </DataGrid>

        <!-- Кнопки правил -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Добавить правило"
                    Width="130" Margin="0,0,10,0"
                    Click="AddRule_Click"/>
            <Button Content="Удалить правило"
                    Width="130" Margin="0,0,10,0"
                    Click="DeleteRule_Click"/>
            <Button Content="ОК"
                    Width="80" Margin="0,0,10,0"
                    Click="Ok_Click"/>
            <Button Content="Отмена"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>

    </Grid>
</Window>

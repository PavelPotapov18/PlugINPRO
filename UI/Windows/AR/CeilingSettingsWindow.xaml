<Window x:Class="PlugINPRO.UI.Windows.AR.CeilingSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlugINPRO.Services.AR"
             xmlns:ar="clr-namespace:PlugINPRO.Services.AR"
        Title="Настройка потолка"
             Height="500" Width="600"
             WindowStartupLocation="CenterScreen">
    

        <Window.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

         <!-- Режим выбора помещений -->
        <GroupBox Header="Режим обработки" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton Content="Выбранные помещения"
                     GroupName="RoomProcessingMode"
                     IsChecked="{Binding IsSelectedRooms, Mode=TwoWay}"/>
                <RadioButton Content="По параметрам помещений"
                     GroupName="RoomProcessingMode"
                     IsChecked="{Binding IsFilteredRooms, Mode=TwoWay}"/>
            </StackPanel>
        </GroupBox>
        <!-- Панель фильтра -->
        <Border Margin="20,6,0,0"
                Grid.Row="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="3"
                Padding="6"
                Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <GroupBox Header="Логика фильтра"
                          Margin="0,10,0,10">

                    <StackPanel Margin="5">
                        <RadioButton
                            Content="Все условия"
                            IsChecked="{Binding FilterMatchMode,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter=All}"/>

                        <RadioButton
                            Content="Хотя бы одно условие"
                            IsChecked="{Binding FilterMatchMode,
                            Mode=TwoWay,
                            Converter={StaticResource EnumToBooleanConverter},
                            ConverterParameter=Any}"/>

                    </StackPanel>

                </GroupBox>

                <DataGrid x:Name="FilterGrid"
                          ItemsSource="{Binding FilterRules}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          MaxHeight="150"
                          Margin="0,0,0,6">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Параметр" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        ItemsSource="{Binding DataContext.RoomParameterNames,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding}"
                                        DisplayMemberPath="."
                                        Loaded="FilterParamCombo_Loaded"
                                        SelectionChanged="FilterParamCombo_SelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Условие" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Tag="{Binding}"
                                              Loaded="FilterConditionCombo_Loaded"
                                              SelectionChanged="FilterConditionCombo_SelectionChanged">
                                        <ComboBoxItem Content="Равно"
                                                      Tag="{x:Static ar:RoomFilterCondition.Equals}"/>
                                        <ComboBoxItem Content="Не равно"
                                                      Tag="{x:Static ar:RoomFilterCondition.NotEquals}"/>
                                        <ComboBoxItem Content="Содержит"
                                                      Tag="{x:Static ar:RoomFilterCondition.Contains}"/>
                                        <ComboBoxItem Content="Не содержит"
                                                      Tag="{x:Static ar:RoomFilterCondition.NotContains}"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Значение" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="+ Условие"
                            Width="90" Margin="0,0,6,0"
                            Click="AddFilterRule_Click"/>
                    <Button Content="- Условие"
                            Width="90"
                            Click="DeleteFilterRule_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>


        <TextBlock Grid.Row="2"
                   Text="Выберите тип потолка:"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"/>

        <ComboBox Grid.Row="3"
                  ItemsSource="{Binding CeilingTypes}"
                  SelectedItem="{Binding SelectedCeilingType, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,15"/>

        

        <!-- Поле ввода для Custom -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="Значение смещения, мм:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Width="80"
                     Text="{Binding CustomOffsetMm, Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}" Height="25"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="ОК"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="Ok_Click"/>
            <Button Content="Отмена"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

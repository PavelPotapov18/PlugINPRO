<Window x:Class="PlugINPRO.UI.Windows.ES.CableTraySupportSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор опоры" 
        Height="200" 
        Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите опору для установки" 
                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <ComboBox x:Name="cmbFamilies" Grid.Row="1" Margin="5" Height="25"
                  DisplayMemberPath="DisplayName"/>

        <TextBlock x:Name="tbInfo" Grid.Row="2" TextWrapping="Wrap" 
                   FontSize="11" Foreground="Gray" Margin="5"
                   TextAlignment="Center"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancel" Content="Отмена" Width="80" Height="30" 
                    Margin="5" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="ОК" Width="80" Height="30" 
                    Margin="5" Click="BtnOk_Click" IsDefault="True" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="PlugINPRO.UI.Windows.TS.DimensionSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки размеров аксонометрии" 
        Height="350" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Режим размеров -->
        <Label Grid.Row="0" Grid.Column="0" Content="Режим размеров:" 
               VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="ModeComboBox" Grid.Row="0" Grid.Column="1" 
                  Margin="5" Height="25" VerticalAlignment="Center">
            <ComboBoxItem Content="Размеры по трубам/воздуховодам" Tag="ByPipeLength"/>
            <ComboBoxItem Content="Размеры от центра фитинга" Tag="ByFittingCenter"/>
            <ComboBoxItem Content="Размеры между опорами (до границ)" Tag="BySupportsToPipe"/>
            <ComboBoxItem Content="Размеры между опорами (до фитингов)" Tag="BySupportsToFittings"/>
        </ComboBox>

        <!-- Тип размера -->
        <Label Grid.Row="1" Grid.Column="0" Content="Тип размера:" 
               VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="DimensionTypeComboBox" Grid.Row="1" Grid.Column="1" 
                  Margin="5" Height="25" VerticalAlignment="Center"
                  DisplayMemberPath="Name"/>

        <!-- Смещение размера -->
        <Label Grid.Row="2" Grid.Column="0" Content="Смещение размера:" 
               VerticalAlignment="Center" Margin="5"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OffsetTextBox" Grid.Column="0" Height="25" 
                     VerticalAlignment="Center" Text="300"/>
            <Label Grid.Column="1" Content="мм" VerticalAlignment="Center" 
                   Margin="5,0,0,0" Width="30"/>
        </Grid>

        <!-- 🆕 ГАЛОЧКА: Проецировать на пол -->
        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" 
                  x:Name="ProjectToFloorCheckBox"
                  Content="Проецировать на горизонтальную плоскость"
                  Margin="10,10,5,5"
                  VerticalAlignment="Center"
                  ToolTip="Размеры будут проецироваться на горизонтальную плоскость (пол), а не на плоскость трубы"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="5">
            <Button x:Name="OkButton" Content="OK" Width="80" Height="30" 
                    Margin="5" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="80" Height="30" 
                    Margin="5" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
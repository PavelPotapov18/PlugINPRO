<Window x:Class="PlugINPRO.UI.Windows.PluginInfo.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О плагине"
        Height="450"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <!-- ЛОГОТИП -->
        <Image
               Source="/PlugINPRO;component/Resources/INPRO.png"
               Margin="0,10,0,303" HorizontalAlignment="Center" Width="398" Grid.Column="1"/>

        <!-- ТЕКСТ -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="1,134,-1,0" Height="141">


            <TextBlock Text="PlugINPRO"
                       FontSize="18"
                       FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Данный плагин является интеллектуальной собственностью компании INPRO Engineering and Consulting"
                       FontSize="16" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Версия: 1.0"
                       FontSize="14"/>
            <TextBlock Text="Revit 2022.1"
                       FontSize="14"
                       Margin="0,0,0,4"/>
            <TextBlock Height="17"><Hyperlink NavigateUri="https://inproec.com/"
                           RequestNavigate="OnNavigate"><Run Text="https://inproec.com/"/></Hyperlink></TextBlock>



        </StackPanel>
    </Grid>
</Window>

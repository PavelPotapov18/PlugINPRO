<Window x:Class="PlugINPRO.UI.Windows.VK.PipeSupportPlaceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка отступа" 
        Height="500" 
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройка отступа опоры" 
                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Информация о позиции -->
        <Border Grid.Row="1" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                Background="#FFF5F5F5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="tbDistanceFromStart" Text="От начала: 1000 мм" Margin="5,3,5,3"/>
                <TextBlock x:Name="tbDistanceFromEnd" Text="От конца: 6000 мм" Margin="5,3,5,3"/>
                <TextBlock x:Name="tbTotalLength" Text="Общая длина: 7000 мм" Margin="5,3,5,3" 
                           FontWeight="Bold" Foreground="DarkBlue"/>
            </StackPanel>
        </Border>

        <!-- 🆕 ГАЛОЧКА: Размер относительно горизонтальной плоскости -->
        <GroupBox Grid.Row="2" Header="Настройки расчета:" Margin="0,5,0,0">
            <StackPanel>
                <CheckBox x:Name="chkProjectToHorizontal" 
                          Content="Размер относительно горизонтальной плоскости"
                          Margin="5"
                          IsChecked="False"
                          ToolTip="При включении отступ пересчитывается с учетом уклона трубы (проекция на горизонталь). При отключении - отступ берется прямо по оси трубы."/>

                <TextBlock x:Name="tbProjectionInfo" 
                           Text="✗ Выключено: отступ по оси трубы (без учета уклона)"
                           FontSize="10" 
                           Foreground="Gray" 
                           Margin="15,0,0,5" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Отступ -->
        <GroupBox Grid.Row="3" Header="Отступ:" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Отступ:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtOffset" Width="80" Text="1000"/>
                    <TextBlock Text=" мм" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Откуда считать -->
        <GroupBox Grid.Row="4" Header="Считать от:" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal" Margin="5">
                <RadioButton x:Name="rbFromStart" Content="От начала" GroupName="Direction" 
                             IsChecked="True" Margin="0,0,15,0"/>
                <RadioButton x:Name="rbFromEnd" Content="От конца" GroupName="Direction"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancel" Content="Отмена" Width="80" Height="30" 
                    Margin="5" Click="BtnCancel_Click"/>
            <Button x:Name="btnOk" Content="Установить" Width="80" Height="30" 
                    Margin="5" Click="BtnOk_Click" IsDefault="True" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
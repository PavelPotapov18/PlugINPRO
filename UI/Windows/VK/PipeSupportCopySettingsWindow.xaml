<Window x:Class="PlugINPRO.UI.Windows.VK.PipeSupportCopySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Копирование опоры вдоль трубы" 
        Height="720" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Копирование опоры вдоль трубы" 
                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Информация о выбранной опоре -->
        <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                Background="#FFF8F8F8">
            <TextBlock x:Name="tbSupportInfo" TextWrapping="Wrap" TextAlignment="Center"
                       FontWeight="Bold" Margin="5">
                Выбрана опора:
            </TextBlock>
        </Border>

        <!-- Информация о трубе -->
        <Border Grid.Row="2" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                Background="#FFF5F5F5">
            <TextBlock x:Name="tbPipeInfo" TextWrapping="Wrap" TextAlignment="Center" 
                       FontSize="12" Margin="5">
                Труба:
            </TextBlock>
        </Border>

        <!-- Информация об уклоне -->
        <Border Grid.Row="3" BorderBrush="#FFE8E8E8" BorderThickness="1" 
                Background="#FFF9F9F9">
            <TextBlock x:Name="tbSlopeInfo" TextWrapping="Wrap" TextAlignment="Center" 
                       FontSize="11" Foreground="#555555" Margin="5">
                Уклон: 0%
            </TextBlock>
        </Border>

        <!-- Смещение -->
        <GroupBox Grid.Row="4" Header="Смещение (по горизонтали):" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Смещение:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtOffset" Width="80" Text="1000"/>
                    <TextBlock Text=" мм" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Положительное значение - вперед по трассе, отрицательное - назад" 
                          FontSize="10" Foreground="Gray" Margin="5,5,0,0" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- Количество и шаг -->
        <GroupBox Grid.Row="5" Header="Копирование нескольких опор:" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtCount" Width="50" Text="2"/>
                    <TextBlock Text=" шт." VerticalAlignment="Center" Margin="5,0,15,0"/>

                    <TextBlock Text="Шаг:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtSpacing" Width="80" Text="1000"/>
                    <TextBlock Text=" мм" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Положительный шаг - копирование вперед, отрицательный - назад" 
                          FontSize="10" Foreground="Gray" Margin="5,5,0,0" TextWrapping="Wrap"/>

                <CheckBox Grid.Row="2" x:Name="chkCopyMultiple" Content="Копировать несколько опор" 
                         Margin="5,5,0,0" Checked="ChkCopyMultiple_Checked" Unchecked="ChkCopyMultiple_Unchecked"/>
            </Grid>
        </GroupBox>

        <!-- Информация -->
        <Border Grid.Row="6" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                Background="#FFF5F5F5" Margin="0,10,0,0">
            <TextBlock x:Name="tbInfo" TextWrapping="Wrap" TextAlignment="Center" 
                       FontSize="11" Margin="5">
                Будет создана копия опоры с указанным смещением вдоль трассы трубы
            </TextBlock>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click"/>
            <Button x:Name="btnCopy" Content="Копировать" 
                    Click="BtnCopy_Click" IsDefault="True" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
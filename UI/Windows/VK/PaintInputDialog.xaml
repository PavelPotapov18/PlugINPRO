<Window x:Class="PlugINPRO.Commands.VK.Windows.PaintInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры краски" 
        Height="300" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Введите параметры краски" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>
        
        <!-- Информация о площади -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                   Name="AreaInfoTextBlock"
                   Text="Расчет площади системы..."
                   Foreground="DarkBlue"
                   FontSize="12"
                   Margin="0,0,0,10"/>
        
        <!-- Наименование краски -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Наименование краски:" 
                   VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" 
                 Name="PaintNameTextBox" 
                 Height="25"
                 Margin="0,0,0,10"/>
        
        <!-- Расход -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Расход (кг/м²):" 
                   VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" 
                 Name="ConsumptionTextBox" 
                 Height="25"
                 Margin="0,0,0,10"/>
        
        <!-- Подсказка -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" 
                   Text="Пример: 0.15" 
                   Foreground="Gray" 
                   FontSize="12"
                   Margin="0,0,0,15"/>
        
        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Name="OkButton" 
                    Content="OK" 
                    Width="80" 
                    Height="30" 
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Name="CancelButton" 
                    Content="Отмена" 
                    Width="80" 
                    Height="30"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
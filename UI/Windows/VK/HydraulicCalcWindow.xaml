<Window x:Class="PlugINPRO.UI.HydraulicCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Гидравлический расчёт - деление на участки"
        Height="500" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding SystemName}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding SystemInfo}" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Sections}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="LightGray">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50" FontWeight="Bold"/>
                <DataGridTextColumn Header="Диаметр (DN)" Binding="{Binding Diameter}" Width="100"/>
                <DataGridTextColumn Header="Длина, м" Binding="{Binding Length}" Width="80"/>
                <DataGridTextColumn Header="Расход, л/с" Binding="{Binding Flow}" Width="90"/>
                <DataGridTextColumn Header="Скорость, м/с" Binding="{Binding Velocity}" Width="90"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding FixtureCount}" Width="70"/>
                <DataGridTextColumn Header="ID труб" Binding="{Binding PipeIds}" Width="120"/>
                <DataGridTextColumn Header="Приборы" Binding="{Binding FixtureNames}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Закрыть" Width="80" Height="25" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
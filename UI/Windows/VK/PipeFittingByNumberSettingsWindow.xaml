<Window x:Class="PlugINPRO.UI.Windows.VK.PipeFittingByNumberSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlugINPRO"
        mc:Ignorable="d"
        Title="Настройки креплений трубопроводов" 
        Height="700" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Настройки креплений трубопроводов" 
                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Выбор шага опор -->
        <GroupBox Grid.Row="1" Header="Шаг установки опор:">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0" x:Name="rb1500" Content="1500 мм" 
                            GroupName="Spacing" IsChecked="True"/>
                <RadioButton Grid.Row="1" x:Name="rb2000" Content="2000 мм" 
                            GroupName="Spacing"/>
                <RadioButton Grid.Row="2" x:Name="rb2500" Content="2500 мм" 
                            GroupName="Spacing"/>
                <RadioButton Grid.Row="3" x:Name="rb3000" Content="3000 мм" 
                            GroupName="Spacing"/>
                <RadioButton Grid.Row="4" x:Name="rbCustom" Content="Другой шаг:" 
                            GroupName="Spacing"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="20,5,0,0">
                    <TextBox x:Name="txtCustomSpacing" Width="80" Text="1000" 
                             IsEnabled="{Binding ElementName=rbCustom, Path=IsChecked}"/>
                    <TextBlock Text=" мм"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Отступ от начала -->
        <GroupBox Grid.Row="2" Header="Отступ от начала трубопровода:" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Отступ:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtOffset" Width="80" Text="0"/>
                    <TextBlock Text=" мм" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="0 мм = начало трубопровода, 1000 мм = через 1 м от начала" 
                          FontSize="10" Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- Количество опор-->
        <GroupBox Grid.Row="3" Header="Количество опор:" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Число:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtNumber" Width="50" Text="0"/>
                </StackPanel>

                
            </Grid>
        </GroupBox>

        <!-- Выбор крепления -->
        <GroupBox Grid.Row="4" Header="Тип крепления:" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0" x:Name="rbPreviousFamily" 
                            Content="Использовать предыдущий выбор" 
                            GroupName="Family" IsChecked="True"/>

                <RadioButton Grid.Row="1" x:Name="rbSelectNewFamily" 
                            Content="Выбрать новое крепление" 
                            GroupName="Family"/>

                <ComboBox Grid.Row="2" x:Name="cmbFamilies" Margin="20,5,0,0"
                         IsEnabled="{Binding ElementName=rbSelectNewFamily, Path=IsChecked}"
                         DisplayMemberPath="DisplayName"/>
            </Grid>
        </GroupBox>

        <!-- Информационная панель -->
        <Border Grid.Row="5" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                Background="#FFF8F8F8" Margin="0,10,0,0">
            <TextBlock x:Name="tbInfo" TextWrapping="Wrap" TextAlignment="Center">
                <Run Text="Выберите шаг, отступ, количество и тип крепления,"/><LineBreak/>
                <Run Text="затем нажмите 'Установить'"/>
            </TextBlock>
        </Border>

        <!-- Информация о предыдущем выборе -->
        <Border Grid.Row="6" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                Background="#FFF5F5F5" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="tbPreviousInfo" TextWrapping="Wrap" Margin="5"/>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click"/>
            <Button x:Name="btnInstall" Content="Установить" 
                    Click="BtnInstall_Click" IsDefault="True" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>